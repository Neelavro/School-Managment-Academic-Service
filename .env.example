DB_URL=jdbc:mysql://localhost:3306/academic_service
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
SERVER_PORT=8084
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# SSLCommerz (sandbox: testbox / qwerty)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=true

# Public URLs — must be reachable from the parent's browser and from SSLCommerz servers respectively
PUBLIC_BASE_URL_FRONTEND=http://localhost:9000
PUBLIC_BASE_URL_BACKEND=http://localhost:8084

# Shared secret used by platform_admin_service to authenticate when polling
# /api/platform/metrics. Set to a random 32+ char string. Same value goes
# into the per-school credential vault on the platform admin side.
PLATFORM_METRICS_SECRET=replace-with-a-random-32-char-secret
